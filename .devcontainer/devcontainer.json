{
  "name": "C++ Dev Container (GCC)",
  "image": "mcr.microsoft.com/vscode/devcontainers/cpp:0-ubuntu-22.04",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake"
      ]
    }
  },
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y valgrind",
  "remoteUser": "vscode"
}
